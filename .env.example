# DelphiAgent environment configuration
# Copy this file to .env and fill in your keys.
# Never commit your real .env to version control.

# ─────────────────────────────────────────────
# Required: Anthropic (agent discussions + web search)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional model overrides per tier.
# Defaults align with the mixed-tier pattern (light/default/heavy).
# DELPHI_MODEL_LIGHT=claude-haiku-4-5-20251001
# DELPHI_MODEL_DEFAULT=claude-sonnet-4-6
# DELPHI_MODEL_HEAVY=claude-opus-4-7

# Optional: disable prompt caching (default: enabled for all system blocks).
# DELPHI_PROMPT_CACHING=off

# ─────────────────────────────────────────────
# Required: OpenAI (embeddings only — convergence similarity)
# ─────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
# Optional: override embedding model (default: text-embedding-3-small)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────
# Optional: cost caps (pence). Used by engine adapter to enforce limits.
# ─────────────────────────────────────────────
# PER_SESSION_COST_PENCE=150
# PER_ACCOUNT_COST_PENCE=450
# DAILY_COST_ALERT_PENCE=500
# GBP_PER_USD=0.79

# Optional: application logging level (not strictly required)
# LOG_LEVEL=info

# ─────────────────────────────────────────────
# Storage backend
#   fs       -> reports/trackers written to the local output/ dir (CLI default)
#   supabase -> reports/run state persisted to Supabase (hosted web deployment)
# ─────────────────────────────────────────────
# DELPHI_STORE=fs

# ─────────────────────────────────────────────
# Supabase (required when DELPHI_STORE=supabase, i.e. the hosted web app)
# Engine uses the service-role key (server-side only, bypasses RLS).
# ─────────────────────────────────────────────
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─────────────────────────────────────────────
# Web app (apps/web) — Next.js public env + engine address
# NEXT_PUBLIC_* values are exposed to the browser (anon key only — never the
# service-role key here).
# ─────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# NEXT_PUBLIC_SITE_URL=http://localhost:3002
# DELPHI_ENGINE_URL=http://localhost:3003   # full URL or bare host (https assumed)

# Local engine port (when not behind Render's injected PORT)
# DELPHI_API_PORT=3003
